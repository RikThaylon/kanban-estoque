# ══════════════════════════════════════════════
# KANBAN ESTOQUE — VARIÁVEIS DE AMBIENTE
# ══════════════════════════════════════════════
# Copie para .env e ajuste os valores

NODE_ENV=development
PORT=3001

# ── PostgreSQL ──────────────────────────────
POSTGRES_DB=kanban_estoque
POSTGRES_USER=kanban_user
POSTGRES_PASSWORD=kanban_pass_2024
DB_PORT=5432
DATABASE_URL=postgresql://kanban_user:kanban_pass_2024@localhost:5432/kanban_estoque

# ── Redis ───────────────────────────────────
# REDIS_ENABLED=false → roda sem Redis (stub em memória — apenas dev local)
# REDIS_ENABLED=true  → exige Redis disponível em REDIS_URL
REDIS_ENABLED=false
REDIS_PASSWORD=redis_pass_2024
REDIS_PORT=6379
REDIS_URL=redis://:redis_pass_2024@localhost:6379

# ── JWT ─────────────────────────────────────
JWT_SECRET=dev_jwt_secret_replace_in_production_min_256_bits_long_string_here
JWT_REFRESH_SECRET=dev_refresh_secret_replace_in_production_min_256_bits_string
DATA_ENCRYPTION_SECRET=dev_data_encryption_secret_replace_in_production_min_256_bits
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── CORS ────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Segurança ──────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_MAX=200
SESSION_SECRET=dev_session_secret_change_me

# ── Frontend (Vite) ────────────────────────
VITE_API_URL=http://localhost:3001/api/v1
VITE_WS_URL=http://localhost:3001
